int fatorial(int n) {
    if (n <= 1) {
        return 1;
    } else {
        return n * fatorial(n - 1);
    }
}

int x = 10;
bool ativo = true;

scan(x);

if (ativo && x >= 10) {
    x = fatorial(x);
    print("Valor atualizado");
} else {
    print("Condicao falsa");
}

while (x < 20) {
    x = x + 1;
}

for (x = 0; x < 3; x = x + 1) {
    print(x);
}

print(fatorial(x));