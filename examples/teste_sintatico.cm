int soma(int a, int b) {
    int resultado = a + b;
    return resultado;
}

int x = 10;
bool ativo = true;

scan(x);

if (ativo && x >= 10) {
    x = soma(x, 5);
    print("Valor atualizado");
} else {
    print("Condicao falsa");
}

while (x < 20) {
    x = x + 1;
}

for (x = 0; x < 3; x = x + 1) {
    print(x);
}

print(soma(x, 2));